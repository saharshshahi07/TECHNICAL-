#include <iostream>
#include <string>
#include <sstream>

int main() {
    std::string str;
    std::cout << "Enter a sentence: ";
    std::getline(std::cin, str);

    std::stringstream ss(str);
    std::string word, largestWord = "";

    while (ss >> word) {
        if (word.length() > largestWord.length()) {
            largestWord = word;
        }
    }

    std::cout << "Largest word: " << largestWord << "\n";
    std::cout << "Length: " << largestWord.length() << "\n";
    return 0;
}
