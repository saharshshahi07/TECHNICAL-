#include <iostream>
#include <cctype>

void checkVowelOrConsonant(char ch) {
    // Pehle check karo ki character alphabet hai ya nahi
    if (!std::isalpha(ch)) {
        std::cout << "'" << ch << "' is not an alphabet.\n";
        return;
    }

    // Comparison aasan karne ke liye lowercase me convert kar lo
    char lowerCh = std::tolower(ch);

    // Vowels check
    if (lowerCh == 'a' || lowerCh == 'e' || lowerCh == 'i' || lowerCh == 'o' || lowerCh == 'u') {
        std::cout << "'" << ch << "' is a Vowel.\n";
    } else {
        std::cout << "'" << ch << "' is a Consonant.\n";
    }
}

int main() {
    char ch;

    std::cout << "Enter a character: ";
    std::cin >> ch;

    checkVowelOrConsonant(ch);

    return 0;
}
