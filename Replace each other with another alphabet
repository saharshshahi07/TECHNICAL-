#include <iostream>
#include <string>
#include <cctype>

int main() {
    std::string str;
    std::cout << "Enter a string: ";
    std::getline(std::cin, str);

    for (char &ch : str) {
        if (ch >= 'a' && ch <= 'z') {
            ch = (ch == 'z') ? 'a' : ch + 1;
        } else if (ch >= 'A' && ch <= 'Z') {
            ch = (ch == 'Z') ? 'A' : ch + 1;
        }
    }

    std::cout << "Modified string: " << str << "\n";
    return 0;
}
