#include <iostream>
#include <string>
#include <random>
#include <limits>

enum class Difficulty {
    EASY = 1,
    MEDIUM = 2,
    HARD = 3
};

class Player {
private:
    std::string name;
    double balance;

public:
    Player(const std::string& playerName, double initialBalance)
        : name(playerName), balance(initialBalance) {}

    std::string getName() const { return name; }
    double getBalance() const { return balance; }

    void addWinnings(double amount) {
        balance += amount;
    }

    void deductBet(double amount) {
        balance -= amount;
    }
};

class CasinoGame {
private:
    Player player;
    std::mt19937 rng;

    int generateRandomNumber(int min, int max) {
        std::uniform_int_distribution<int> dist(min, max);
        return dist(rng);
    }

    void clearInputBuffer() {
        std::cin.clear();
        std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
    }

public:
    CasinoGame(const std::string& name, double balance)
        : player(name, balance), rng(std::random_device{}()) {}

    void displayRules() const {
        std::cout << "\n======================================================\n";
        std::cout << "               CASINO NUMBER GUESSING RULES           \n";
        std::cout << "======================================================\n";
        std::cout << " 1. Choose a difficulty level:\n";
        std::cout << "    - Easy   : Guess 1 to 5  (Multiplier: 2x)\n";
        std::cout << "    - Medium : Guess 1 to 10 (Multiplier: 5x)\n";
        std::cout << "    - Hard   : Guess 1 to 20 (Multiplier: 10x)\n";
        std::cout << " 2. If you guess correctly, you win the prize multiplier!\n";
        std::cout << " 3. If you guess wrong, you lose your betting amount.\n";
        std::cout << "======================================================\n\n";
    }

    void playRound() {
        std::cout << "\nCurrent Balance: Rs. " << player.getBalance() << "\n";

        // Step 1: Bet input & validation
        double betAmount = 0.0;
        while (true) {
            std::cout << "Enter betting amount: Rs. ";
            if (std::cin >> betAmount && betAmount > 0 && betAmount <= player.getBalance()) {
                break;
            }
            std::cout << "Invalid bet! Amount must be > 0 and within your balance.\n";
            clearInputBuffer();
        }

        // Step 2: Difficulty selection
        int choice = 0;
        int maxRange = 5;
        double multiplier = 2.0;

        while (true) {
            std::cout << "\nSelect Difficulty Level:\n";
            std::cout << "1. Easy (1-5)\n";
            std::cout << "2. Medium (1-10)\n";
            std::cout << "3. Hard (1-20)\n";
            std::cout << "Choice (1-3): ";
            
            if (std::cin >> choice && choice >= 1 && choice <= 3) {
                break;
            }
            std::cout << "Invalid choice! Enter 1, 2, or 3.\n";
            clearInputBuffer();
        }

        Difficulty level = static_cast<Difficulty>(choice);
        switch (level) {
            case Difficulty::EASY:
                maxRange = 5;
                multiplier = 2.0;
                break;
            case Difficulty::MEDIUM:
                maxRange = 10;
                multiplier = 5.0;
                break;
            case Difficulty::HARD:
                maxRange = 20;
                multiplier = 10.0;
                break;
        }

        // Step 3: Player guess
        int playerGuess = 0;
        while (true) {
            std::cout << "Guess a number between 1 and " << maxRange << ": ";
            if (std::cin >> playerGuess && playerGuess >= 1 && playerGuess <= maxRange) {
                break;
            }
            std::cout << "Invalid guess! Number must be within 1 and " << maxRange << ".\n";
            clearInputBuffer();
        }

        // Step 4: Outcome evaluation
        int winningNumber = generateRandomNumber(1, maxRange);
        std::cout << "\nDice is rolling... Computer generated: " << winningNumber << "\n";

        if (playerGuess == winningNumber) {
            double prize = betAmount * multiplier;
            player.addWinnings(prize - betAmount);
            std::cout << "JACKPOT! Congratulations " << player.getName() 
                      << ", you won Rs. " << prize << "!\n";
        } else {
            player.deductBet(betAmount);
            std::cout << "Bad luck! You lost Rs. " << betAmount << ".\n";
        }

        std::cout << "Updated Balance: Rs. " << player.getBalance() << "\n";
    }

    void start() {
        displayRules();
        char playAgain = 'y';

        while (player.getBalance() > 0 && (playAgain == 'y' || playAgain == 'Y')) {
            playRound();

            if (player.getBalance() <= 0) {
                std::cout << "\nYou ran out of money! Game Over.\n";
                break;
            }

            std::cout << "\nDo you want to play another round? (y/n): ";
            std::cin >> playAgain;
        }

        std::cout << "\nThank you for playing, " << player.getName() 
                  << "! You leave with Rs. " << player.getBalance() << ".\n";
    }
};

int main() {
    std::string name;
    double initialDeposit = 0.0;

    std::cout << "==========================================\n";
    std::cout << "       WELCOME TO THE C++ CASINO          \n";
    std::cout << "==========================================\n";
    std::cout << "Enter your name: ";
    std::getline(std::cin, name);

    while (true) {
        std::cout << "Enter starting deposit: Rs. ";
        if (std::cin >> initialDeposit && initialDeposit > 0) {
            break;
        }
        std::cout << "Please enter a valid deposit amount greater than 0.\n";
        std::cin.clear();
        std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
    }

    CasinoGame game(name, initialDeposit);
    game.start();

    return 0;
}
