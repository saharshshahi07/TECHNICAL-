#include <iostream>
#include <cmath>
#include <iomanip>

void findRoots(double a, double b, double c) {
    if (a == 0) {
        std::cout << "Invalid equation! 'a' cannot be 0 in a quadratic equation.\n";
        return;
    }

    double discriminant = (b * b) - (4 * a * c);
    std::cout << std::fixed << std::setprecision(2);

    // Case 1: Real and distinct roots
    if (discriminant > 0) {
        double root1 = (-b + std::sqrt(discriminant)) / (2 * a);
        double root2 = (-b - std::sqrt(discriminant)) / (2 * a);
        std::cout << "Roots are real and distinct:\n";
        std::cout << "Root 1 = " << root1 << "\n";
        std::cout << "Root 2 = " << root2 << "\n";
    }
    // Case 2: Real and equal roots
    else if (discriminant == 0) {
        double root = -b / (2 * a);
        std::cout << "Roots are real and equal:\n";
        std::cout << "Root 1 = Root 2 = " << root << "\n";
    }
    // Case 3: Complex roots
    else {
        double realPart = -b / (2 * a);
        double imaginaryPart = std::sqrt(-discriminant) / (2 * a);
        std::cout << "Roots are complex and imaginary:\n";
        std::cout << "Root 1 = " << realPart << " + " << imaginaryPart << "i\n";
        std::cout << "Root 2 = " << realPart << " - " << imaginaryPart << "i\n";
    }
}

int main() {
    double a, b, c;

    std::cout << "Enter coefficients a, b, and c (ax^2 + bx + c = 0):\n";
    std::cout << "a: ";
    std::cin >> a;
    std::cout << "b: ";
    std::cin >> b;
    std::cout << "c: ";
    std::cin >> c;

    findRoots(a, b, c);

    return 0;
}
